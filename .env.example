# Supabase (Milestone 2+)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Needed to finish signup profile writes.
# SUPABASE_SERVICE_ROLE_KEY=

# Public app origin for email links and the Penny image.
# When this is unset, or still points at the retired preview host, mail uses
# https://app.nextgenachievers.com.
# NEXT_PUBLIC_APP_URL=https://app.nextgenachievers.com

# Resend transactional email (optional in local/dev — missing key simulates sends)
# RESEND_API_KEY=
# Must use a verified Resend domain (mail.nextgenachievers.com)
# RESEND_FROM_EMAIL=NextGenAchievers <onboarding@mail.nextgenachievers.com>

# Required in production (set this in Vercel). Long random string that signs
# password-reset links. Do not reuse SUPABASE_SERVICE_ROLE_KEY. If this is
# unset in production, password recovery fails closed.
# Local development uses a dev-only fallback when this is unset.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NGA_TOKEN_SECRET=

# Daily privacy cron (Vercel Hobby). Required in production. Vercel sends this
# as Authorization: Bearer <CRON_SECRET> on /api/cron/privacy-retention.
# If it is unset, the route does nothing and returns 401.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CRON_SECRET=

# xAI Grok (later milestones - never OpenAI)
# XAI_API_KEY=

# AES-256-GCM key for profiles.class_password_enc. Server-only.
# Never prefix with NEXT_PUBLIC_. Required to open the class page, save a
# class password, or create a teacher account. If it is missing or not 32
# bytes, those server actions fail with a clear error and do not store
# plaintext. Use the same key on every environment that reads this database.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# CLASS_PASSWORD_KEY=

# Master-workbook lessons. Off in production. On for a Vercel preview unless
# this is 0. Set to 1 to turn the master on locally. The public name is what
# the Academy map can see.
# ACADEMY_MASTER_PAYLOAD=
# NEXT_PUBLIC_ACADEMY_MASTER_PAYLOAD=
# Public storage base for lesson pictures and audio. Empty uses files in /public.
# NEXT_PUBLIC_ACADEMY_MEDIA_BASE=
