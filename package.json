{
  "name": "nextgenachievers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node tools/clean-next.mjs && next dev",
    "prebuild": "node tools/check-dev-not-running.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate": "npm run lint && npm run typecheck && npm run test",
    "lesson:export": "npx tsx tools/export-course-authoring.ts",
    "seed:demo": "npx tsx --conditions=react-server scripts/seed-demo-accounts.ts",
    "backfill:class-passwords": "npx tsx --conditions=react-server scripts/backfill-class-password-enc.ts",
    "lesson:import": "node tools/import-lesson-from-sheet.mjs",
    "lesson:import:explorer": "node tools/import-explorer-workbook.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "15.5.27",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "15.5.27",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@eslint/eslintrc": {
      "brace-expansion": "1.1.21"
    },
    "@typescript-eslint/typescript-estree": {
      "brace-expansion": "5.0.12"
    },
    "js-yaml": "4.3.2",
    "nanoid": "3.3.20",
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
