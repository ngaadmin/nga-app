# Supabase (Milestone 2+)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App origin used in transactional email CTAs (optional; falls back to request host)
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend transactional email (optional in local/dev — missing key simulates sends)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=NextGenAchievers <onboarding@your-verified-domain.com>

# xAI Grok (later milestones - never OpenAI)
# XAI_API_KEY=
