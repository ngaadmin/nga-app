# Supabase (Milestone 2+)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Needed to finish signup profile writes.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional public app origin for client use. Email CTAs always use production
# (https://nga-app-three.vercel.app) and ignore this value / localhost.
# NEXT_PUBLIC_APP_URL=https://nga-app-three.vercel.app

# Resend transactional email (optional in local/dev — missing key simulates sends)
# RESEND_API_KEY=
# Must use a verified Resend domain (mail.nextgenachievers.com)
# RESEND_FROM_EMAIL=NextGenAchievers <onboarding@mail.nextgenachievers.com>

# HMAC secret for password-reset links. Optional: falls back to EMAIL_API_SECRET,
# then SUPABASE_SERVICE_ROLE_KEY. Localhost uses a dev-only fallback if all are unset.
# NGA_TOKEN_SECRET=

# xAI Grok (later milestones - never OpenAI)
# XAI_API_KEY=
